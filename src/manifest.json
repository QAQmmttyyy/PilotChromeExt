{
  "manifest_version": 3,
  "name": "Pilot - AI Script Runner",
  "version": "1.0.0",
  "description": "Create and run AI-generated scripts on any webpage.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "webNavigation",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {},
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["main-world.js", "page-agent-init.js"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "csp_rules",
      "enabled": true,
      "path": "rules/csp_rules.json"
    }]
  }
}
